{
  "name": "agent-observatory",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first observability for AI environments, projects, agents, skills, plugins, hooks, and MCP servers.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev:dashboard",
    "dev:dashboard": "npm run dev --workspace @agent-observatory/dashboard",
    "dev:daemon": "npm run dev --workspace @agent-observatory/daemon",
    "start:daemon": "npm run start --workspace @agent-observatory/daemon",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
