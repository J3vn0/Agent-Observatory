# Agent Observatory local daemon
AGENT_OBSERVATORY_PORT=4317

# Optional path overrides. Leave blank to use ~/.codex and ~/.agents.
AGENT_OBSERVATORY_CODEX_HOME=
AGENT_OBSERVATORY_AGENTS_HOME=

# Optional dashboard API override. The Vite proxy is used when blank.
VITE_OBSERVATORY_API=

# Optional future integrations. They are not required for local scanning.
GITHUB_TOKEN=
OPENAI_API_KEY=
SEC_USER_AGENT=
